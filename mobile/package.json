{
  "name": "scalper-mobile",
  "version": "1.0.0",
  "description": "Scalper options terminal mobile wrapper for iOS and Android",
  "private": true,
  "scripts": {
    "bundle": "node scripts/sync-assets.js",
    "sync": "npm run bundle && cap sync",
    "build": "npm run bundle && cap copy",
    "cap": "cap",
    "android": "cap run android",
    "ios": "cap run ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
